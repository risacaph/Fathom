<Window x:Class="Fathom.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fathom Secure Viewer" Height="760" Width="1100"
        MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <!-- ================= LOGIN ================= -->
        <Grid x:Name="LoginPanel">
            <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="28"
                    Width="380" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Fathom Secure Viewer" Foreground="{StaticResource Fg}"
                               FontSize="22" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Text="Sign in to your Fathom server" Foreground="{StaticResource Muted}"
                               Margin="0,0,0,16" />

                    <TextBlock Text="Server URL" Foreground="{StaticResource Muted}" />
                    <TextBox x:Name="ServerUrlBox" Text="http://localhost:5000" />

                    <TextBlock Text="Username" Foreground="{StaticResource Muted}" Margin="0,8,0,0" />
                    <TextBox x:Name="UsernameBox" />

                    <TextBlock Text="Password" Foreground="{StaticResource Muted}" Margin="0,8,0,0" />
                    <PasswordBox x:Name="PasswordBox" />

                    <Button x:Name="LoginButton" Content="Sign in" Click="Login_Click"
                            HorizontalAlignment="Stretch" Margin="0,16,0,0" />
                    <TextBlock x:Name="LoginStatus" Foreground="#FF6B6B" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= BROWSE ================= -->
        <Grid x:Name="BrowsePanel" Visibility="Collapsed" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                <TextBlock Text="Find a document" Foreground="{StaticResource Fg}" FontSize="18"
                           FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left" />
                <Button Content="Sign out" Click="Logout_Click" DockPanel.Dock="Right"
                        Background="{StaticResource Panel}" Foreground="{StaticResource Fg}" />
            </DockPanel>

            <DockPanel Grid.Row="1" Margin="0,0,0,10">
                <Button Content="Search" Click="Search_Click" DockPanel.Dock="Right" />
                <TextBox x:Name="SearchBox" KeyDown="SearchBox_KeyDown" VerticalContentAlignment="Center" />
            </DockPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Series" DockPanel.Dock="Top" Foreground="{StaticResource Muted}" Margin="2,0,0,4" />
                    <ListBox x:Name="SeriesList" SelectionChanged="SeriesList_SelectionChanged"
                             Background="{StaticResource Panel}" Foreground="{StaticResource Fg}" BorderThickness="0" />
                </DockPanel>

                <DockPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Documents" DockPanel.Dock="Top" Foreground="{StaticResource Muted}" Margin="2,0,0,4" />
                    <Button DockPanel.Dock="Bottom" Content="Open in secure viewer" Click="Open_Click"
                            HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                    <ListBox x:Name="ChapterList" MouseDoubleClick="ChapterList_DoubleClick"
                             Background="{StaticResource Panel}" Foreground="{StaticResource Fg}" BorderThickness="0" />
                </DockPanel>
            </Grid>
        </Grid>

        <!-- ================= READER ================= -->
        <Grid x:Name="ReaderPanel" Visibility="Collapsed" Background="#05101F">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Background="{StaticResource Panel}" LastChildFill="False">
                <Button Content="Close" Click="CloseReader_Click" DockPanel.Dock="Left"
                        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}" />
                <TextBlock x:Name="ReaderTitle" Foreground="{StaticResource Fg}" VerticalAlignment="Center"
                           Margin="12,0" FontWeight="SemiBold" DockPanel.Dock="Left" />
                <Button x:Name="NextButton" Content="Next ›" Click="Next_Click" DockPanel.Dock="Right" />
                <TextBlock x:Name="PageIndicator" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                           Margin="10,0" DockPanel.Dock="Right" />
                <Button x:Name="PrevButton" Content="‹ Prev" Click="Prev_Click" DockPanel.Dock="Right"
                        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}" />
            </DockPanel>

            <Border Grid.Row="1" ClipToBounds="True">
                <Image x:Name="PageImage" ContextMenu="{x:Null}"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Stretch="Uniform" Margin="8" />
            </Border>
        </Grid>
    </Grid>
</Window>

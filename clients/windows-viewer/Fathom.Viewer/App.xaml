<Application x:Class="Fathom.Viewer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0B1F3A" />
        <SolidColorBrush x:Key="Panel" Color="#12294A" />
        <SolidColorBrush x:Key="Accent" Color="#1AC7BC" />
        <SolidColorBrush x:Key="Fg" Color="#E8EEF5" />
        <SolidColorBrush x:Key="Muted" Color="#8AA0B8" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#06202B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </Application.Resources>
</Application>
